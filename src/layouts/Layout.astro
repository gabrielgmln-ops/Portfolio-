---
import { ClientRouter } from 'astro:transitions';
import serifa from '@fontsource/newsreader/files/newsreader-latin-500-normal.woff2?url';
// O parágrafo de abertura costuma ser o LCP: a sans do texto também vem em preload.
import sans from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import { getPerfil } from '../lib/conteudo';
import { jsonLdPerson, metaPagina, serializarJsonLd } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  titulo: string;
  descricao: string;
  /** caminho da imagem OG (PNG 1200×630 gerado em build) */
  og?: string;
  /** só a home publica o JSON-LD Person */
  pessoa?: boolean;
  noindex?: boolean;
}
const { titulo, descricao, og = '/og/portfolio.png', pessoa = false, noindex = false } = Astro.props;
const perfil = getPerfil();
const meta = metaPagina({ titulo, descricao, caminho: Astro.url.pathname, site: Astro.site, nomeSite: perfil.nome });
const ogUrl = Astro.site ? new URL(og, Astro.site).href : og;
const ld = pessoa ? serializarJsonLd(jsonLdPerson(perfil, Astro.site)) : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/tema.js"></script>
    <link rel="icon" href="data:," />
    <link rel="preload" href={serifa} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <title>{meta.titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex" />}
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    {meta.og.map((m) => (
      <meta property={m.property} content={m.content} />
    ))}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#14262A" />
    {ld && <script type="application/ld+json" is:inline set:html={ld} />}
    <ClientRouter />
  </head>
  <body>
    <a class="pular" href="#conteudo">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
