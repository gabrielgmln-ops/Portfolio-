---
import { ClientRouter } from 'astro:transitions';
// Os títulos grandes (letreiro, destaque, declaração) usam a Newsreader 300: é ela que vem em preload.
import serifa from '@fontsource/newsreader/files/newsreader-latin-300-normal.woff2?url';
// O parágrafo de abertura costuma ser o LCP: a sans do texto também vem em preload.
import sans from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import { getPerfil } from '../lib/conteudo';
import { jsonLdPerson, metaPagina, serializarJsonLd } from '../lib/seo';
import Abertura from '../components/Abertura.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  titulo: string;
  descricao: string;
  /** caminho da imagem OG (PNG 1200×630 gerado em build) */
  og?: string;
  /** só a home publica o JSON-LD Person */
  pessoa?: boolean;
  noindex?: boolean;
  /** só a home tem a abertura "Olá" */
  abertura?: boolean;
}
const { titulo, descricao, og = '/og/portfolio.png', pessoa = false, noindex = false, abertura = false } = Astro.props;
const perfil = getPerfil();
const meta = metaPagina({ titulo, descricao, caminho: Astro.url.pathname, site: Astro.site, nomeSite: perfil.nome });
const ogUrl = Astro.site ? new URL(og, Astro.site).href : og;
const ld = pessoa ? serializarJsonLd(jsonLdPerson(perfil, Astro.site)) : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/tema.js"></script>
    <link rel="icon" href="data:," />
    <link rel="preload" href={serifa} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <title>{meta.titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex" />}
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    {meta.og.map((m) => (
      <meta property={m.property} content={m.content} />
    ))}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0c1717" />
    {ld && <script type="application/ld+json" is:inline set:html={ld} />}
    <ClientRouter />
  </head>
  <body>
    <a class="pular skip" href="#conteudo">
      Pular para o conteúdo
    </a>
    {abertura && <Abertura />}
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* ---- Peças v7 compartilhadas pelos componentes ----
     Estado padrão = estado FINAL visível. O "escondido antes de animar" só vale
     sob html.js-motion (classe posta pelo time de movimento). Ganchos: docs/motion.md. */
  main:focus {
    outline: none;
  }
  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .mask > span {
    display: block;
  }
  html.js-motion .mask > span {
    transform: translateY(108%);
    transition: transform 1s var(--expo);
  }
  html.js-motion .on .mask > span,
  html.js-motion .mask.on > span {
    transform: none;
  }
  html.js-motion .sobe {
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 0.8s var(--saida),
      transform 0.8s var(--saida);
  }
  html.js-motion .sobe.on {
    opacity: 1;
    transform: none;
  }

  /* rótulo de seção: h2 discreto à esquerda, contexto à direita */
  .rotulo {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--texto-3);
    border-bottom: 1px solid var(--linha);
    padding-bottom: 1rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .rotulo h2,
  .rotulo h1 {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
  }
  section.s {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  /* botão redondo (magnético: só ele e a pílula recebem .magnetico) */
  .redondo {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(8.5rem, 12vw, 11rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--fundo-3);
    color: #e9dec5;
    font-weight: 600;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  .redondo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #c9a96a;
    border-radius: 50%;
    transform: translateY(102%);
    transition: transform 0.6s var(--expo);
  }
  .redondo span {
    transition: color 0.4s;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pilula {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 3.2rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    border: 1px solid var(--linha-forte);
    font-weight: 600;
    font-size: 0.95rem;
    overflow: hidden;
    isolation: isolate;
    transition:
      color 0.5s var(--expo),
      border-color 0.3s;
  }
  .pilula::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--fundo-3);
    border-radius: inherit;
    transform: translateY(102%);
    transition: transform 0.55s var(--expo);
  }
  .pilula--cheia {
    background: var(--fundo-3);
    color: #e9dec5;
    border-color: var(--fundo-3);
  }
  .pilula--cheia::before {
    background: #c9a96a;
  }
  .externo {
    font-size: 0.85em;
  }
  .nota-pequena {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    color: var(--texto-3);
  }

  @media (hover: hover) and (pointer: fine) {
    .redondo:hover::before {
      transform: none;
    }
    .redondo:hover span {
      color: #121a19;
    }
    .pilula:hover::before {
      transform: none;
    }
    .pilula:hover {
      color: #e9dec5;
      border-color: var(--fundo-3);
    }
    .pilula--cheia:hover {
      color: #121a19;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .redondo::before,
    .redondo span,
    .pilula,
    .pilula::before {
      transition: none;
    }
  }
</style>
