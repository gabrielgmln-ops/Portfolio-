---
// Status em texto + ícone de traço; a cor nunca é o único sinal.
import type { Status } from '../lib/conteudo';
import { ROTULO_STATUS } from '../ui/formato';

interface Props {
  status: Status;
  /** sobre a arte da carta: fundo opaco próprio */
  sobreCarta?: boolean;
}
const { status, sobreCarta = false } = Astro.props;
---

<span class:list={['status', { 'status--carta': sobreCarta }]} data-status={status}>
  <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
    {status === 'concluido' && <path d="M2 6.5 5 9.5 10 3" />}
    {status === 'em-desenvolvimento' && <path d="M6 1.5a4.5 4.5 0 1 0 4.5 4.5M6 6V3.5" />}
    {status === 'planejado' && <circle cx="6" cy="6" r="4.5" stroke-dasharray="2 2" />}
  </svg>
  {ROTULO_STATUS[status]}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: 0.05em var(--s-2);
    border: var(--traco) solid currentColor;
    border-radius: var(--raio);
    font-family: var(--fonte-mono);
    font-size: var(--t--1);
    line-height: 1.5;
    white-space: nowrap;
    color: var(--texto-2);
  }
  .status svg {
    width: 0.75em;
    height: 0.75em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .status[data-status='concluido'] {
    color: var(--acento);
  }
  .status[data-status='em-desenvolvimento'] {
    color: var(--alerta);
  }
  .status--carta {
    background: var(--petroleo-950);
    font-size: 0.6875rem;
  }
  .status--carta[data-status='em-desenvolvimento'] {
    color: var(--vinho-claro);
    border-color: var(--vinho);
  }
</style>
