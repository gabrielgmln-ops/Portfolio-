---
// Abertura "Olá" com cortina curva. Escondida por padrão (sem JS ela nunca aparece).
// O time de movimento a exibe com html.js-motion[data-intro] e a recolhe com .sai.
---

<div class="intro" aria-hidden="true">
  <p>Olá</p>
</div>

<style>
  .intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    place-items: center;
    background: var(--rodape);
    color: var(--rodape-texto);
    transition: transform 0.9s var(--expo);
  }
  :global(html.js-motion[data-intro]) .intro {
    display: grid;
  }
  .intro:global(.sai) {
    transform: translateY(-100%);
  }
  .intro::after {
    content: '';
    position: absolute;
    left: -10%;
    right: -10%;
    top: 100%;
    height: 12vh;
    background: var(--rodape);
    border-radius: 0 0 50% 50%;
    transition: height 0.9s var(--expo);
  }
  .intro:global(.sai)::after {
    height: 0;
  }
  .intro p {
    margin: 0;
    font: 300 clamp(2.4rem, 5vw, 4rem) / 1 var(--serifa);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .intro p::before {
    content: '';
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--ouro);
  }
  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none !important;
    }
  }
</style>
