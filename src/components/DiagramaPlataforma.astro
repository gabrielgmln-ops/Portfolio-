---
// Diagrama da plataforma bancária sintética. SVG acessível + descrição em texto equivalente.
// Cores via classes com tokens: funciona nos dois temas.
interface Props {
  /** prefixo de id (o diagrama pode aparecer duas vezes numa página, ex.: /_kit) */
  id?: string;
  grande?: boolean;
  /** mostra a lista equivalente aberta (página /plataforma) ou num <details> */
  descricaoAberta?: boolean;
}
const { id = 'diag', grande = false, descricaoAberta = false } = Astro.props;
const seta = `${id}-seta`;
---

<figure class:list={['diagrama', { 'diagrama--grande': grande }]}>
  <svg viewBox="0 0 820 440" role="img" aria-labelledby={`${id}-t ${id}-d`} focusable="false">
    <title id={`${id}-t`}>Diagrama da plataforma bancária</title>
    <desc id={`${id}-d`}>
      O cliente fala com o Gateway de Segurança, que fica na frente da Ledger API, do Pix Simulado e do Motor
      Antifraude. O Pix liquida na Ledger; o Antifraude consome as transações da Ledger via Kafka. A Operação Cofre
      endurece a Ledger. O Robô de Fechamento Diário lê a Ledger só para leitura e fecha o dia. A Esteira DevSecOps com
      SIEM observa tudo.
    </desc>
    <defs>
      <marker id={seta} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path class="d-ponta" d="M0 0L10 5L0 10z"></path>
      </marker>
    </defs>

    <rect class="d-moldura" x="10" y="10" width="800" height="420" rx="18"></rect>
    <text class="d-rot" x="30" y="414">
      <tspan class="d-num">V</tspan> · Esteira DevSecOps + SIEM observa tudo
    </text>

    <g class="d-linhas">
      <line x1="146" y1="215" x2="197" y2="215" marker-end={`url(#${seta})`}></line>
      <line x1="362" y1="195" x2="437" y2="92" marker-end={`url(#${seta})`}></line>
      <line x1="362" y1="215" x2="437" y2="215" marker-end={`url(#${seta})`}></line>
      <line x1="362" y1="235" x2="437" y2="338" marker-end={`url(#${seta})`}></line>
      <line x1="525" y1="122" x2="525" y2="172" marker-end={`url(#${seta})`}></line>
      <line x1="525" y1="257" x2="525" y2="307" marker-end={`url(#${seta})`}></line>
      <line x1="668" y1="215" x2="614" y2="215" marker-end={`url(#${seta})`}></line>
      <line class="d-leitura" x1="600" y1="173" x2="688" y2="124" marker-end={`url(#${seta})`}></line>
    </g>
    <text class="d-rot" x="535" y="152">
      liquida
    </text>
    <text class="d-rot" x="535" y="287">
      Kafka
    </text>

    <g class="d-caixa">
      <rect x="34" y="185" width="110" height="60" rx="10"></rect>
      <text x="89" y="221" text-anchor="middle">
        Cliente
      </text>
    </g>
    <g class="d-caixa">
      <rect x="200" y="170" width="160" height="90" rx="10"></rect>
      <text class="d-num" x="280" y="198" text-anchor="middle">
        IV
      </text>
      <text x="280" y="222" text-anchor="middle">
        Gateway de
      </text>
      <text x="280" y="242" text-anchor="middle">
        Segurança
      </text>
    </g>
    <g class="d-caixa">
      <rect x="440" y="40" width="170" height="80" rx="10"></rect>
      <text class="d-num" x="525" y="70" text-anchor="middle">
        III
      </text>
      <text x="525" y="96" text-anchor="middle">
        Pix Simulado
      </text>
    </g>
    <g class="d-caixa d-caixa--centro">
      <rect x="440" y="175" width="170" height="80" rx="10"></rect>
      <text class="d-num" x="525" y="205" text-anchor="middle">
        VIII
      </text>
      <text x="525" y="231" text-anchor="middle">
        Ledger API
      </text>
    </g>
    <g class="d-caixa">
      <rect x="440" y="310" width="170" height="80" rx="10"></rect>
      <text class="d-num" x="525" y="340" text-anchor="middle">
        I
      </text>
      <text x="525" y="366" text-anchor="middle">
        Motor Antifraude
      </text>
    </g>
    <g class="d-caixa">
      <rect x="670" y="175" width="120" height="80" rx="10"></rect>
      <text class="d-num" x="730" y="200" text-anchor="middle">
        II
      </text>
      <text x="730" y="222" text-anchor="middle">
        Operação
      </text>
      <text x="730" y="242" text-anchor="middle">
        Cofre
      </text>
    </g>
    <text class="d-rot" x="641" y="236" text-anchor="middle">
      endurece
    </text>
    <g class="d-caixa">
      <rect x="650" y="40" width="150" height="80" rx="10"></rect>
      <text class="d-num" x="725" y="64" text-anchor="middle">
        XI
      </text>
      <text x="725" y="86" text-anchor="middle">
        Robô de
      </text>
      <text x="725" y="106" text-anchor="middle">
        Fechamento
      </text>
    </g>
    <text class="d-rot" x="712" y="150" text-anchor="middle">
      só leitura
    </text>
  </svg>
  <details class="diagrama__texto" open={descricaoAberta}>
    <summary>Descrição do diagrama em texto</summary>
    <ul>
      <li>
        O cliente fala com o <strong>Gateway de Segurança</strong> (IV).
      </li>
      <li>
        O Gateway fica na frente da <strong>Ledger API</strong> (VIII), do <strong>Pix Simulado</strong> (III) e do{' '}
        <strong>Motor Antifraude</strong> (I).
      </li>
      <li>O Pix liquida na Ledger.</li>
      <li>O Antifraude consome as transações da Ledger via Kafka.</li>
      <li>
        A <strong>Operação Cofre</strong> (II) endurece a Ledger.
      </li>
      <li>
        O <strong>Robô de Fechamento Diário</strong> (XI) lê a Ledger só para leitura e faz o fechamento do dia.
      </li>
      <li>
        A <strong>Esteira DevSecOps + SIEM</strong> (V) observa tudo.
      </li>
    </ul>
  </details>
</figure>

<style>
  .diagrama {
    margin: 0;
    color: var(--texto);
  }
  .diagrama svg {
    width: 100%;
    height: auto;
    max-width: 52rem;
    font-family: var(--sans);
    font-size: 16px;
  }
  .diagrama--grande svg {
    max-width: none;
  }
  .d-moldura {
    fill: none;
    stroke: var(--linha-forte);
    stroke-width: 1.2;
    stroke-dasharray: 6 6;
  }
  .d-linhas line {
    stroke: var(--linha-forte);
    stroke-width: 1.4;
  }
  .d-linhas line.d-leitura {
    stroke-dasharray: 5 4;
  }
  .d-ponta {
    fill: var(--linha-forte);
  }
  .d-caixa rect {
    fill: var(--fundo-2);
    stroke: var(--linha-forte);
    stroke-width: 1.2;
  }
  .d-caixa--centro rect {
    stroke: var(--ouro);
    stroke-width: 1.8;
  }
  .d-caixa text {
    fill: var(--texto);
  }
  .d-num {
    fill: var(--ouro);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.12em;
  }
  .d-caixa text.d-num {
    fill: var(--ouro);
  }
  .d-rot {
    fill: var(--texto-2);
    font-family: var(--mono);
    font-size: 12px;
  }
  .diagrama__texto {
    margin-top: 1.25rem;
    color: var(--texto-2);
    font-size: 0.95rem;
  }
  .diagrama__texto summary {
    cursor: pointer;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    color: var(--texto);
  }
  .diagrama__texto ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }
  .diagrama__texto strong {
    color: var(--texto);
    font-weight: 600;
  }
</style>
