---
// Estudo de caso. A ordem das seções é fixa; seção sem conteúdo não aparece (nem no índice).
interface Secao {
  id: string;
  titulo: string;
  texto?: string | undefined;
  lista?: string[] | undefined;
}
interface Props {
  secoes: Secao[];
  /** títulos do corpo MDX (slot "corpo"), entram no índice antes do Resultado */
  corpo?: { id: string; titulo: string }[] | undefined;
}

const temSlot = (id: string): boolean => Astro.slots.has(id);
const secoes = Astro.props.secoes.filter((s) => !!s.texto || !!s.lista?.length || temSlot(s.id));
const corpo = Astro.slots.has('corpo') ? (Astro.props.corpo ?? []) : [];
const htmlCorpo = Astro.slots.has('corpo') ? await Astro.slots.render('corpo') : undefined;
// O corpo entra antes do Resultado (ou no fim, se não houver Resultado).
const posCorpo = (() => {
  const i = secoes.findIndex((s) => s.id === 'resultado');
  return i < 0 ? secoes.length : i;
})();
const indice = [...secoes.slice(0, posCorpo), ...corpo, ...secoes.slice(posCorpo)];
const htmlSlots = new Map<string, string>();
for (const s of secoes) if (temSlot(s.id)) htmlSlots.set(s.id, await Astro.slots.render(s.id));
---

{(secoes.length > 0 || htmlCorpo) && (
  <div class="estudo">
    {indice.length > 1 && (
      <nav class="estudo__indice mono" aria-label="Nesta página">
        <span class="estudo__rot">Estudo de caso</span>
        <ol>
          {indice.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.titulo}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="estudo__corpo">
      {secoes.map((s, i) => (
        <>
          {i === posCorpo && htmlCorpo && <div class="estudo__mdx" data-revelar set:html={htmlCorpo} />}
          <section class="estudo__secao" id={s.id} aria-labelledby={`${s.id}-t`} data-revelar>
            <h2 id={`${s.id}-t`}>{s.titulo}</h2>
            {s.texto && <p>{s.texto}</p>}
            {s.lista && s.lista.length > 0 && (
              <ul>
                {s.lista.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            )}
            {htmlSlots.has(s.id) && <Fragment set:html={htmlSlots.get(s.id)} />}
          </section>
        </>
      ))}
      {posCorpo === secoes.length && htmlCorpo && <div class="estudo__mdx" data-revelar set:html={htmlCorpo} />}
    </div>
  </div>
)}

<style>
  .estudo {
    display: grid;
    gap: 2rem;
    border-top: 1px solid var(--linha);
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  @media (min-width: 64rem) {
    .estudo {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 4rem;
    }
    .estudo__indice {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
  }
  .estudo__rot {
    display: block;
    color: var(--texto-3);
    margin-bottom: 1rem;
  }
  .estudo__indice ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--linha);
  }
  .estudo__indice li {
    border-bottom: 1px solid var(--linha);
  }
  .estudo__indice a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--texto-2);
  }
  @media (hover: hover) and (pointer: fine) {
    .estudo__indice a:hover {
      color: var(--ouro);
    }
  }
  .estudo__corpo {
    max-width: 68ch;
    color: var(--texto-2);
  }
  .estudo__secao,
  .estudo__mdx {
    padding-bottom: 2rem;
  }
  .estudo__secao,
  .estudo__mdx :global(h2) {
    scroll-margin-top: 2rem;
  }
  .estudo__secao h2,
  .estudo__mdx :global(h2) {
    margin: 2.5rem 0 1rem;
    font: 300 clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem) / 1.1 var(--serifa);
    letter-spacing: -0.025em;
    color: var(--texto);
  }
  .estudo__mdx :global(h2:first-child) {
    margin-top: 0;
  }
  .estudo__mdx :global(h3) {
    font: 400 1.35rem/1.25 var(--serifa);
    color: var(--texto);
    margin: 2rem 0 0.75rem;
  }
  .estudo__mdx :global(strong) {
    color: var(--texto);
  }
  .estudo__mdx :global(a) {
    color: var(--ouro);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .estudo__mdx :global(ul),
  .estudo__mdx :global(ol),
  .estudo__secao ul {
    padding-left: 1.25rem;
  }
  .estudo__mdx :global(li + li) {
    margin-top: 0.5rem;
  }
  .estudo__mdx :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--linha);
    border-radius: 0.5rem;
    background: var(--fundo-2);
    font-size: 0.85rem;
  }
  .estudo__mdx :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .estudo__mdx :global(th),
  .estudo__mdx :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--linha);
    text-align: left;
  }
</style>
