---
import { getPerfil } from '../lib/conteudo';
const perfil = getPerfil();
const caminho = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/projetos', rotulo: 'Projetos' },
  { href: '/sobre', rotulo: 'Sobre' },
  { href: '/#contato', rotulo: 'Contato' },
];
---

<header class="topo">
  <div class="envoltorio topo__linha">
    <a class="topo__nome" href="/">
      {perfil.nome}
    </a>
    <nav aria-label="Principal">
      <ul class="topo__nav">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={caminho === l.href || caminho.startsWith(`${l.href}/`) ? 'page' : undefined}>
              {l.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="topo__tema" type="button" aria-pressed="false" data-tema-botao>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <circle cx="8" cy="8" r="6"></circle>
        <path d="M8 2a6 6 0 0 0 0 12z"></path>
      </svg>
      Tema claro
    </button>
  </div>
</header>

<style>
  .topo {
    background: var(--fundo);
    border-bottom: var(--traco) solid var(--borda);
    z-index: 10;
  }
  @media (min-width: 64rem) {
    .topo {
      position: sticky;
      top: 0;
    }
  }
  .topo__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-3);
  }
  .topo__nome {
    font-family: var(--fonte-serifa);
    font-size: var(--t-1);
    color: var(--texto);
    text-decoration: none;
    margin-inline-end: auto;
  }
  .topo__nav {
    list-style: none;
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
  }
  .topo__nav a {
    color: var(--texto);
    text-decoration: none;
    padding-block: var(--s-2);
  }
  .topo__nav a[aria-current='page'] {
    color: var(--acento);
    text-decoration: underline;
  }
  @media (hover: hover) and (pointer: fine) {
    .topo__nav a:hover {
      color: var(--acento);
    }
  }
  .topo__tema {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3);
    font: inherit;
    font-size: var(--t--1);
    color: var(--texto-2);
    background: transparent;
    border: var(--traco) solid var(--texto-2);
    border-radius: var(--raio);
    cursor: pointer;
  }
  .topo__tema svg {
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
  }
  .topo__tema path {
    fill: currentColor;
    stroke: none;
  }
  .topo__tema[aria-pressed='true'] {
    color: var(--acento);
    border-color: var(--acento);
  }
</style>

<script>
  import '../scripts/tema';
</script>
