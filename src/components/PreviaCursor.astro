---
// Prévia da carta que segue o cursor sobre o índice + bolha "Ver". Só marcação e CSS:
// o time de movimento posiciona (left/top via CSSOM), troca o src e alterna .vis.
// Escondida em toque/sem hover e com redução de movimento.
---

<div class="preview" aria-hidden="true">
  <img alt="" src="data:," width="416" height="624" decoding="async" />
</div>
<div class="ver" aria-hidden="true">
  Ver
</div>

<style>
  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 13rem;
    aspect-ratio: 2/3;
    border-radius: 0.75rem;
    overflow: hidden;
    pointer-events: none;
    box-shadow: var(--sombra);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.45s var(--saida);
  }
  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .preview:global(.vis) {
    transform: translate(-50%, -50%) scale(1);
  }
  .ver {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 41;
    width: 5rem;
    height: 5rem;
    margin: -2.5rem 0 0 -2.5rem;
    border-radius: 50%;
    background: #c9a96a;
    color: #121a19;
    display: grid;
    place-items: center;
    font-weight: 600;
    font-size: 0.9rem;
    pointer-events: none;
    transform: scale(0);
    transition: transform 0.4s var(--saida);
  }
  .ver:global(.vis) {
    transform: scale(1);
  }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .preview,
    .ver {
      display: none;
    }
  }
</style>
