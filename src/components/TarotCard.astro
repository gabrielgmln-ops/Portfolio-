---
// A carta. Moldura, numeral e nome são desenhados aqui (texto real); a arte é só a cena.
import { Picture } from 'astro:assets';
import { getCarta, type Project } from '../lib/conteudo';
import { nomeAcessivel } from '../ui/formato';
import StatusBadge from './StatusBadge.astro';

interface Props {
  projeto: Project;
  /** acima da dobra: carrega sem lazy e com prioridade */
  prioridade?: boolean;
  /** sem link (verso do Roteiro, capa do estudo de caso) */
  semLink?: boolean;
  /** largura de exibição para o atributo sizes */
  sizes?: string;
  /** nome da View Transition (M5) */
  transicao?: string;
}

const {
  projeto,
  prioridade = false,
  semLink = false,
  sizes = '(min-width: 48rem) 15rem, 60vw',
  transicao,
} = Astro.props;
const carta = getCarta(projeto);
if (carta.estado === 'revelada' && !projeto.resultado) {
  throw new Error(`[TarotCard] "${projeto.slug}" está concluído sem resultado medido: a carta não pode ser revelada.`);
}
const href = semLink || carta.estado === 'verso' ? undefined : `/projetos/${projeto.slug}`;
const Tag = href ? 'a' : 'div';
const larguras = [320, 480, 720, 1080];
const carregamento = prioridade ? 'eager' : 'lazy';
---

<Tag
  class="carta"
  data-estado={carta.estado}
  data-carta
  href={href}
  aria-label={href ? nomeAcessivel(projeto) : undefined}
  transition:name={transicao as string}
>
  <div class="carta__corpo" data-carta-corpo>
    <div class="carta__face carta__face--frente" aria-hidden={carta.estado === 'verso' ? 'true' : undefined}>
      <Picture
        src={carta.imagem}
        alt={carta.estado === 'verso' ? '' : carta.alt}
        formats={['avif', 'webp']}
        widths={larguras}
        sizes={sizes}
        loading={carregamento}
        fetchpriority={prioridade ? 'high' : 'auto'}
        class="carta__arte"
      />
      <svg class="carta__moldura" viewBox="0 0 200 300" aria-hidden="true" focusable="false">
        <rect x="5" y="5" width="190" height="290" rx="7" class="m-externa"></rect>
        <rect x="10" y="10" width="180" height="280" rx="4" class="m-interna"></rect>
        <path class="m-canto" d="M10 26 L26 10 M174 10 L190 26 M190 274 L174 290 M26 290 L10 274"></path>
      </svg>
      <span class="carta__numeral">{projeto.arcano.numeral}</span>
      <span class="carta__base">
        <span class="carta__nome">{projeto.arcano.nome}</span>
        {carta.estado === 'revelada' && <span class="carta__resultado">{projeto.resultado}</span>}
      </span>
      {carta.estado === 'em-desenvolvimento' && (
        <span class="carta__selo">
          <StatusBadge status={projeto.status} sobreCarta />
        </span>
      )}
    </div>
    <div class="carta__face carta__face--verso" aria-hidden="true">
      <Picture
        src={carta.verso}
        alt=""
        formats={['avif', 'webp']}
        widths={larguras}
        sizes={sizes}
        loading={carregamento}
        class="carta__arte"
      />
      <svg class="carta__moldura carta__moldura--fina" viewBox="0 0 200 300" aria-hidden="true" focusable="false">
        <rect x="6" y="6" width="188" height="288" rx="6" class="m-interna"></rect>
      </svg>
    </div>
  </div>
</Tag>

<style>
  .carta {
    --rx: 0deg;
    --ry: 0deg;
    --elev: 0px;
    position: relative;
    display: block;
    width: var(--carta-largura);
    aspect-ratio: 2 / 3;
    border-radius: var(--raio-carta);
    color: var(--creme);
    text-decoration: none;
    transform: perspective(900px) translateY(var(--elev)) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform var(--dur-ui) ease;
  }
  .carta:focus-visible {
    outline-offset: 4px;
  }
  .carta__corpo {
    position: absolute;
    inset: 0;
    /* perspectiva para a virada (M2) mora no pai imediato */
    transform-style: preserve-3d;
    border-radius: inherit;
  }
  .carta[data-estado='verso'] .carta__corpo {
    transform: rotateY(180deg);
  }
  .carta__face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--petroleo-700);
    backface-visibility: hidden;
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--ouro) 35%, transparent) inset,
      0 10px 24px -12px color-mix(in srgb, var(--petroleo-950) 80%, transparent);
  }
  .carta__face--verso {
    transform: rotateY(180deg);
  }
  .carta__face :global(picture) {
    display: contents;
  }
  .carta__face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .carta__moldura {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--ouro);
    pointer-events: none;
  }
  .m-externa {
    stroke-width: 1.6;
  }
  .m-interna {
    stroke-width: 0.6;
  }
  .m-canto {
    stroke-width: 0.6;
  }
  .carta__numeral,
  .carta__base {
    position: absolute;
    inset-inline: 10%;
    text-align: center;
    background: color-mix(in srgb, var(--petroleo-950) 84%, transparent);
    border: var(--traco) solid color-mix(in srgb, var(--ouro) 55%, transparent);
    border-radius: var(--raio);
  }
  .carta__numeral {
    top: 6%;
    inset-inline: 38%;
    padding-block: 0.1em;
    font-family: var(--fonte-serifa);
    font-size: 0.875rem;
    color: var(--ouro);
    letter-spacing: 0.06em;
  }
  .carta__base {
    bottom: 5%;
    padding: var(--s-1) var(--s-2);
    display: grid;
    gap: var(--s-1);
  }
  .carta__nome {
    font-family: var(--fonte-serifa);
    font-size: 0.875rem;
    line-height: 1.2;
  }
  .carta__resultado {
    font-family: var(--fonte-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.625rem;
    line-height: 1.35;
    color: var(--creme-2);
  }
  .carta__selo {
    position: absolute;
    top: 16%;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Estados */
  .carta[data-estado='em-desenvolvimento'] .carta__face--frente :global(img) {
    filter: grayscale(0.85) brightness(0.7);
    transition: filter var(--dur-ui) ease;
  }
  .carta[data-estado='em-desenvolvimento'] .m-externa {
    stroke-width: 0.6;
  }
  .carta[data-estado='em-desenvolvimento'] .m-canto {
    display: none;
  }

  /* M3: elevação + inclinação (as variáveis --rx/--ry vêm de scripts/motion/tilt.ts) */
  @media (hover: hover) and (pointer: fine) {
    .carta[href]:hover {
      --elev: -6px;
    }
    .carta[data-estado='em-desenvolvimento'][href]:hover .carta__face--frente :global(img) {
      filter: grayscale(0.55) brightness(0.8);
    }
  }
  .carta[href]:focus-visible {
    --elev: -6px;
    --rx: 0deg;
    --ry: 0deg;
  }
  .carta[data-inclinando] {
    transition: none;
  }

  /* M4: brilho de folha de ouro (uma vez, disparado por scripts/motion/brilho.ts) */
  .carta[data-estado='revelada'] .carta__face--frente::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 35%,
      color-mix(in srgb, var(--creme) 18%, transparent) 50%,
      transparent 65%
    );
    mix-blend-mode: screen;
    transform: translateX(-120%);
    -webkit-mask: linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0);
    pointer-events: none;
  }
  .carta[data-brilho='sim'] .carta__face--frente::after {
    animation: brilho var(--dur-cena) var(--ease-in-out-cubic) 1 both;
  }
  @keyframes brilho {
    to {
      transform: translateX(120%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carta,
    .carta :global(img) {
      transition: none;
    }
    .carta[data-brilho='sim'] .carta__face--frente::after {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/motion/cartas';
</script>
