---
// Índice de projetos (linha por carta). data-preview = URL webp ~416px da carta, data-preview-alt = alt.
// Desktop com cursor: o movimento faz a carta seguir o cursor (.preview/.ver em PreviaCursor.astro).
// Toque / sem hover: a carta pequena aparece na própria linha (CSS).
import { getImage, Picture } from 'astro:assets';
import { getCarta, type Project } from '../lib/conteudo';
import { ROTULO_STATUS } from '../ui/formato';

interface Props {
  projetos: Project[];
  /** nomeia as miniaturas para a View Transition (não usar onde o leque já nomeia as mesmas cartas) */
  vt?: boolean;
}
const { projetos, vt = false } = Astro.props;
const linhas = await Promise.all(
  projetos.map(async (p) => {
    const carta = getCarta(p);
    const img = await getImage({ src: carta.imagem, width: 416, format: 'webp', quality: 60 });
    return { p, carta, previa: img.src };
  }),
);
---

<ul class="indice">
  {linhas.map(({ p, carta, previa }) => (
    <li>
      <a href={`/projetos/${p.slug}`} data-preview={previa} data-preview-alt={carta.alt}>
        <span class="n mono">{p.arcano.numeral}</span>
        <span class="t">{p.titulo}</span>
        <span class="p">{p.linhaIndice ?? p.resumo}</span>
        <span class="st mono">{p.stackCurta ?? ROTULO_STATUS[p.status]}</span>
        <span class="mini" aria-hidden="true" data-vt={vt ? `carta-${p.slug}` : undefined}>
          <Picture
            src={carta.imagem}
            alt=""
            formats={['avif', 'webp']}
            widths={[80, 160]}
            sizes="3.2rem"
            quality={60}
            loading="lazy"
          />
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .indice {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--linha);
  }
  .indice a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 2.2rem 0;
    border-bottom: 1px solid var(--linha);
    transition:
      padding 0.6s var(--saida),
      opacity 0.4s;
  }
  @media (min-width: 48rem) {
    .indice a {
      grid-template-columns: 5rem 1.4fr 1fr 11rem;
      padding: 2.8rem 0;
    }
  }
  .n {
    color: var(--texto-3);
  }
  .t {
    font: 300 var(--t-indice) / 1 var(--serifa);
    letter-spacing: -0.035em;
  }
  .p {
    display: none;
    color: var(--texto-2);
    font-size: 0.93rem;
  }
  @media (min-width: 48rem) {
    .p {
      display: block;
    }
  }
  .st {
    color: var(--texto-3);
    text-align: right;
  }
  .mini {
    display: none;
  }
  /* sem hover (toque): a carta pequena entra na linha, no lugar da pilha técnica */
  @media (hover: none), (pointer: coarse) {
    .indice a {
      grid-template-columns: 2.4rem 1fr 3.2rem;
      padding: 1.25rem 0;
    }
    .st {
      display: none;
    }
    .mini {
      display: block;
      grid-column: 3;
      grid-row: 1;
      width: 3.2rem;
      height: 4.8rem;
      border-radius: 0.35rem;
      overflow: hidden;
      box-shadow: var(--sombra);
    }
    .mini :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .indice:hover a {
      opacity: 0.4;
    }
    .indice a:hover,
    .indice a:focus-visible {
      opacity: 1;
      padding-inline: 1.2rem 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .indice a {
      transition: none;
    }
  }
</style>
