---
// A tiragem: as cartas visíveis em leque (desktop) ou trilho com scroll-snap (mobile).
import { getProjetosVisiveis, type Project } from '../lib/conteudo';
import TarotCard from './TarotCard.astro';

interface Props {
  /** por padrão, getProjetosVisiveis() */
  projetos?: Project[];
  /** liga a distribuição M1 (só na home) */
  distribuir?: boolean;
}
const { distribuir = false } = Astro.props;
const projetos = Astro.props.projetos ?? (await getProjetosVisiveis());
---

{projetos.length > 0 && (
  <ul class="tiragem" data-qtd={projetos.length} data-tiragem={distribuir ? 'distribuir' : undefined}>
    {projetos.map((p) => (
      <li class="tiragem__item">
        <TarotCard projeto={p} transicao={`carta-${p.slug}`} />
        <p class="tiragem__legenda">{p.titulo}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .tiragem {
    list-style: none;
    margin: 0;
    padding: var(--s-4) var(--s-5) var(--s-5);
    display: flex;
    gap: var(--s-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--s-5);
    margin-inline: calc(-1 * var(--s-5));
  }
  .tiragem__item {
    flex: 0 0 auto;
    scroll-snap-align: center;
    display: grid;
    justify-items: center;
    gap: var(--s-3);
  }
  .tiragem__legenda {
    margin: 0;
    font-family: var(--fonte-serifa);
    font-size: var(--t-1);
  }
  .tiragem[data-qtd='1'],
  .tiragem[data-qtd='2'] {
    justify-content: center;
  }

  /* Desktop: leque determinístico pelo índice (−3° a 3°, deslocamento pequeno) */
  @media (min-width: 48rem) {
    .tiragem {
      overflow: visible;
      justify-content: center;
      gap: var(--s-6);
      margin-inline: 0;
      padding-inline: 0;
    }
    .tiragem__item {
      --rot: 0deg;
      --dy: 0px;
      transform: translateY(var(--dy)) rotate(var(--rot));
      transform-origin: 50% 100%;
    }
    .tiragem__item:nth-child(5n + 1) {
      --rot: -3deg;
      --dy: 8px;
    }
    .tiragem__item:nth-child(5n + 2) {
      --rot: 1.5deg;
      --dy: 0px;
    }
    .tiragem__item:nth-child(5n + 3) {
      --rot: -1.5deg;
      --dy: 4px;
    }
    .tiragem__item:nth-child(5n + 4) {
      --rot: 3deg;
      --dy: 10px;
    }
    .tiragem__item:nth-child(5n + 5) {
      --rot: -0.75deg;
      --dy: 2px;
    }
    /* Uma carta: sem rotação. Duas: espelhadas, para a composição ficar simétrica. */
    .tiragem[data-qtd='1'] .tiragem__item {
      --rot: 0deg;
      --dy: 0px;
    }
    .tiragem[data-qtd='2'] .tiragem__item:nth-child(1) {
      --rot: -2deg;
      --dy: 4px;
    }
    .tiragem[data-qtd='2'] .tiragem__item:nth-child(2) {
      --rot: 2deg;
      --dy: 4px;
    }
  }
</style>

<script>
  import '../scripts/motion/distribuir';
</script>
