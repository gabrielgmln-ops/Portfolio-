---
// Próximas cartas: um verso só e até 4 linhas, sem página própria.
import { Picture } from 'astro:assets';
import { getCarta, getRoteiro, type Project } from '../lib/conteudo';

interface Props {
  projetos?: Project[];
  idTitulo?: string;
}
const { idTitulo = 'roteiro-titulo' } = Astro.props;
const projetos = Astro.props.projetos ?? (await getRoteiro(4));
const primeiro = projetos[0];
---

{primeiro && (
  <div class="roteiro" data-roteiro>
    <div class="roteiro__pilha" aria-hidden="true" data-pilha>
      <Picture
        src={getCarta(primeiro).verso}
        alt=""
        formats={['avif', 'webp']}
        widths={[320, 480]}
        sizes="10rem"
        loading="lazy"
      />
    </div>
    <ol class="roteiro__lista" aria-labelledby={idTitulo}>
      {projetos.map((p) => (
        <li class="roteiro__linha">
          <span class="roteiro__arcano">
            <span class="roteiro__numeral">{p.arcano.numeral}</span> {p.arcano.nome}
          </span>
          <span class="roteiro__nome">{p.titulo}</span>
          {p.resumo && <span class="roteiro__frase">{p.resumo}</span>}
          {p.prova && (
            <span class="roteiro__prova">
              <span class="texto-2">Critério de prova:</span> {p.prova}
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
)}

<style>
  .roteiro {
    display: grid;
    gap: var(--s-6);
    align-items: start;
  }
  @media (min-width: 40rem) {
    .roteiro {
      grid-template-columns: 10rem 1fr;
    }
  }
  .roteiro__pilha {
    width: 10rem;
    aspect-ratio: 2 / 3;
    border-radius: var(--raio-carta);
    overflow: hidden;
    border: var(--traco) solid var(--ouro);
    background: var(--petroleo-700);
  }
  .roteiro__pilha :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .roteiro__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .roteiro__linha {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-bottom: var(--traco) solid var(--borda);
  }
  .roteiro__linha:first-child {
    padding-top: 0;
  }
  .roteiro__arcano {
    font-family: var(--fonte-serifa);
    color: var(--acento);
  }
  .roteiro__numeral {
    font-family: var(--fonte-mono);
    font-size: var(--t--1);
  }
  .roteiro__nome {
    font-size: var(--t-1);
    font-weight: 600;
  }
  .roteiro__frase,
  .roteiro__prova {
    max-width: var(--medida);
  }
</style>
