---
import Layout from '../layouts/Layout.astro';
import TarotCard from '../components/TarotCard.astro';
import Tiragem from '../components/Tiragem.astro';
import Roteiro from '../components/Roteiro.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { getPerfil, getProjeto, getProjetosVisiveis, getRoteiro } from '../lib/conteudo';
import { formatarData, isoData } from '../ui/formato';

const perfil = getPerfil();
const visiveis = await getProjetosVisiveis();
const roteiro = await getRoteiro(4);
const louco = await getProjeto('portfolio');
// "Agora": o que está em curso e o último resultado medido, só com dados do conteúdo.
const agora = [...visiveis].sort((a, b) => b.atualizadoEm.getTime() - a.atualizadoEm.getTime());
const descricao = perfil.apresentacao ?? `Portfólio de ${perfil.nome}.`;
---

<Layout titulo={`${perfil.nome} · Portfólio`} descricao={descricao} pessoa>
  <section class="abertura envoltorio" aria-labelledby="titulo-home">
    <div class="abertura__texto">
      <h1 id="titulo-home">{perfil.nome}</h1>
      {perfil.apresentacao && <p class="abertura__frase">{perfil.apresentacao}</p>}
      <ul class="abertura__contato">
        {perfil.email && (
          <li>
            <a href={`mailto:${perfil.email}`}>{perfil.email}</a>
          </li>
        )}
        {perfil.github && (
          <li>
            <a href={perfil.github.url}>GitHub</a>
          </li>
        )}
        {perfil.linkedin && (
          <li>
            <a href={perfil.linkedin}>LinkedIn</a>
          </li>
        )}
      </ul>
    </div>
    {louco && (
      <div class="abertura__carta">
        <TarotCard projeto={louco} prioridade sizes="(min-width: 48rem) 16rem, 70vw" />
      </div>
    )}
  </section>

  {agora.length > 0 && (
    <section class="secao envoltorio" aria-labelledby="titulo-agora">
      <h2 id="titulo-agora">Agora</h2>
      <ul class="agora">
        {agora.map((p) => (
          <li>
            <a href={`/projetos/${p.slug}`}>{p.titulo}</a>
            <StatusBadge status={p.status} />
            {p.resultado ? (
              <span class="mono texto-2">{p.resultado}</span>
            ) : (
              <span class="texto-2">
                atualizado em <time datetime={isoData(p.atualizadoEm)}>{formatarData(p.atualizadoEm)}</time>
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="secao envoltorio" aria-labelledby="titulo-tiragem">
    <h2 id="titulo-tiragem">A tiragem</h2>
    <p class="texto-2">Cada projeto é uma carta. Ela só vira quando há prova medida.</p>
    <Tiragem projetos={visiveis} distribuir />
  </section>

  {roteiro.length > 0 && (
    <section class="secao envoltorio" aria-labelledby="roteiro-titulo">
      <h2 id="roteiro-titulo">Próximas cartas</h2>
      <Roteiro projetos={roteiro} />
    </section>
  )}

  <section class="secao envoltorio" id="contato" aria-labelledby="titulo-contato">
    <h2 id="titulo-contato">Contato</h2>
    <dl class="contato">
      {perfil.email && (
        <>
          <dt>E-mail</dt>
          <dd>
            <a href={`mailto:${perfil.email}`}>{perfil.email}</a>
          </dd>
        </>
      )}
      {perfil.github && (
        <>
          <dt>GitHub</dt>
          <dd>
            <a href={perfil.github.url}>{perfil.github.usuario}</a>
          </dd>
        </>
      )}
      {perfil.linkedin && (
        <>
          <dt>LinkedIn</dt>
          <dd>
            <a href={perfil.linkedin}>{perfil.linkedin.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
          </dd>
        </>
      )}
    </dl>
  </section>
</Layout>

<style>
  .abertura {
    display: grid;
    gap: var(--s-6);
    align-items: center;
    padding-block: var(--s-7) var(--s-8);
  }
  @media (min-width: 48rem) {
    .abertura {
      grid-template-columns: 1fr auto;
      gap: var(--s-8);
      padding-block: var(--s-8);
    }
  }
  .abertura__frase {
    font-size: var(--t-1);
    line-height: 1.5;
    color: var(--texto-2);
    max-width: 38rem;
  }
  .abertura__contato {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
  }
  .abertura__carta {
    justify-self: center;
    --carta-largura: 16rem;
  }
  .agora {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .agora li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
  }
  .agora a {
    font-family: var(--fonte-serifa);
    font-size: var(--t-1);
  }
  .contato {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--s-2) var(--s-5);
  }
  .contato dt {
    color: var(--texto-2);
  }
  .contato dd {
    margin: 0;
  }
</style>
