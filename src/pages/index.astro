---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Declaracao from '../components/Declaracao.astro';
import Trabalho from '../components/Trabalho.astro';
import FaixaPlataforma from '../components/FaixaPlataforma.astro';
import Sobre from '../components/Sobre.astro';
import { getPerfil } from '../lib/conteudo';

const perfil = getPerfil();
const descricao = perfil.apresentacao ?? `Portfólio de ${perfil.nome}.`;
---

<Layout titulo={`${perfil.nome} · Back-end para bancos e fintechs`} descricao={descricao} pessoa abertura>
  <Hero />
  <Declaracao />
  <Trabalho />
  <FaixaPlataforma />
  <Sobre />
</Layout>
