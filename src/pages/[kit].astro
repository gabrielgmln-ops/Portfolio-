---
// /_kit — vitrine interna dos componentes v7 (noindex, fora do sitemap).
// Arquivos com "_" não viram rota no Astro; o parâmetro dinâmico contorna isso.
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import CartaArcano from '../components/CartaArcano.astro';
import Numeros from '../components/Numeros.astro';
import FichaTecnica from '../components/FichaTecnica.astro';
import LinksProjeto from '../components/LinksProjeto.astro';
import LogTransacoes from '../components/LogTransacoes.astro';
import Indice from '../components/Indice.astro';
import DiagramaPlataforma from '../components/DiagramaPlataforma.astro';
import Timeline from '../components/Timeline.astro';
import SkillGroup from '../components/SkillGroup.astro';
import { getMarcos, getProjeto, getProjetosVisiveis, getRoteiro } from '../lib/conteudo';

export const getStaticPaths = (() => [{ params: { kit: '_kit' } }]) satisfies GetStaticPaths;

const visiveis = await getProjetosVisiveis();
const [planejado] = await getRoteiro(1);
const emDev = visiveis.find((p) => p.status === 'em-desenvolvimento');
const ledger = await getProjeto('ledger-api');
const marcos = await getMarcos();
const exemplos = [planejado, emDev, ledger].filter((p) => p !== undefined);
---

<Layout titulo="Kit de componentes" descricao="Vitrine interna dos componentes do portfólio." noindex>
  <div class="px kit">
    <h1>Kit</h1>
    <p>Use o botão de tema no topo para conferir os dois temas.</p>

    <h2>CartaArcano — três estados</h2>
    <div class="kit__cartas">
      {exemplos.map((p) => (
        <figure>
          <CartaArcano projeto={p} />
          <figcaption class="mono">status: {p.status}</figcaption>
        </figure>
      ))}
    </div>

    {ledger && (
      <>
        <h2>Numeros</h2>
        {ledger.metricas && <Numeros metricas={ledger.metricas} />}
        <h2>FichaTecnica</h2>
        {ledger.ficha && <FichaTecnica ficha={ledger.ficha} />}
        <h2>LinksProjeto</h2>
        <LinksProjeto projeto={ledger} estudo />
      </>
    )}

    <h2>LogTransacoes</h2>
    <div class="kit__log">
      <LogTransacoes />
    </div>

    <h2>Indice</h2>
    <Indice projetos={visiveis.slice(0, 3)} />

    <h2>DiagramaPlataforma</h2>
    <DiagramaPlataforma id="diag-kit" />

    <h2>SkillGroup</h2>
    {ledger && (
      <SkillGroup titulo="Exemplo" itens={ledger.competencias.slice(0, 4).map((nome) => ({ nome, projeto: ledger }))} />
    )}

    <h2>Timeline</h2>
    <Timeline marcos={marcos} />
  </div>
</Layout>

<style>
  .kit {
    padding-block: 3rem;
  }
  .kit h2 {
    margin-top: 4rem;
  }
  .kit__cartas {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .kit__cartas figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }
  .kit__log {
    max-width: 40rem;
  }
</style>
