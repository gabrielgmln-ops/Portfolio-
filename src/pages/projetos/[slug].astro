---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import CartaArcano from '../../components/CartaArcano.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import Numeros from '../../components/Numeros.astro';
import FichaTecnica from '../../components/FichaTecnica.astro';
import LinksProjeto from '../../components/LinksProjeto.astro';
import { getEstudo, getPerfil, getProjeto, getProjetosVisiveis, type Project } from '../../lib/conteudo';
import { formatarData, isoData, ROTULO_STATUS } from '../../ui/formato';

export const getStaticPaths = (async () => {
  const visiveis = await getProjetosVisiveis();
  return visiveis.map((p) => ({ params: { slug: p.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const projeto = (await getProjeto(slug)) as Project;
const perfil = getPerfil();
const estudo = await getEstudo(slug);

// Só campos do contrato; o que não existe não vira seção (CaseStudy as filtra).
const secoes = [
  // Com corpo escrito, a prova detalhada está nele; o resumo de `prova` só aparece sem corpo.
  { id: 'testes', titulo: 'Testes', texto: estudo ? undefined : projeto.prova },
  { id: 'resultado', titulo: 'Resultado', texto: projeto.resultado },
];
const descricao = projeto.resumo ?? `${projeto.arcano.nome} — ${projeto.titulo}, projeto de ${perfil.nome}.`;
const mes = new Intl.DateTimeFormat('pt-BR', { month: 'short', timeZone: 'UTC' });
const mesAno = (d: Date): string => `${mes.format(d).replace('.', '')}/${d.getUTCFullYear()}`;
---

<Layout titulo={`${projeto.titulo} · ${perfil.nome}`} descricao={descricao} og={`/og/${projeto.slug}.png`}>
  <article class="proj px">
    <header class="proj__topo">
      <CartaArcano
        projeto={projeto}
        prioridade
        sizes="(max-width: 48rem) 60vw, 16rem"
        vt={`carta-${projeto.slug}`}
        class="proj__capa"
      />
      <div class="proj__dados">
        <span class="mono proj__arcano">
          {projeto.arcano.numeral} · {projeto.arcano.nome} · {ROTULO_STATUS[projeto.status]}
          {projeto.medidoEm && <> em {mesAno(projeto.medidoEm)}</>}
        </span>
        <h1>{projeto.titulo}</h1>
        {projeto.resumo && <p class="proj__resumo">{projeto.resumo}</p>}
        {projeto.papel && <p class="proj__papel">{projeto.papel}</p>}
        {projeto.metricas && <Numeros metricas={projeto.metricas} />}
        {projeto.ficha && <FichaTecnica ficha={projeto.ficha} />}
        <LinksProjeto projeto={projeto} />
      </div>
    </header>

    <CaseStudy secoes={secoes} corpo={estudo?.secoes}>
      {estudo && <estudo.Conteudo slot="corpo" />}
    </CaseStudy>

    {projeto.medidoEm && (
      <p class="mono proj__medido">
        Medido em <time datetime={isoData(projeto.medidoEm)}>{formatarData(projeto.medidoEm)}</time>
      </p>
    )}

    {projeto.changelog.length > 0 && (
      <section class="s" aria-labelledby="titulo-changelog">
        <div class="rotulo mono">
          <h2 id="titulo-changelog">Changelog</h2>
          <span>{projeto.changelog.length} entradas</span>
        </div>
        <ol class="changelog mono">
          {[...projeto.changelog]
            .sort((a, b) => b.data.getTime() - a.data.getTime())
            .map((c) => (
              <li>
                <time datetime={isoData(c.data)}>{isoData(c.data)}</time>
                <span>{c.texto}</span>
              </li>
            ))}
        </ol>
      </section>
    )}
  </article>
</Layout>

<style>
  .proj {
    padding-top: clamp(2rem, 6vw, 5rem);
  }
  .proj__topo {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  @media (min-width: 48rem) {
    .proj__topo {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .proj__topo :global(.proj__capa) {
      position: sticky;
      top: 2rem;
    }
  }
  .proj__topo :global(.proj__capa) {
    --w: clamp(11rem, 50vw, 16rem);
  }
  .proj__arcano {
    color: var(--ouro);
  }
  h1 {
    margin: 0.5rem 0 1rem;
    font: 300 var(--t-destaque) / 0.95 var(--serifa);
    letter-spacing: -0.045em;
  }
  .proj__resumo {
    color: var(--texto-2);
    max-width: 52ch;
    font-size: 1.15rem;
  }
  .proj__papel {
    color: var(--texto-3);
    max-width: 60ch;
    font-size: 0.95rem;
  }
  .proj__dados :global(.ficha-t) {
    max-width: 40rem;
  }
  .proj__medido {
    color: var(--texto-3);
  }
  .changelog {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .changelog li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    color: var(--texto-2);
  }
</style>
